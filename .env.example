# Telegraph Purse configuration template.
#
# Copy to .env (npm run setup does this for you) and fill in the key.
# This file is a template only: it must never contain a real private key.

# --- Connection ---------------------------------------------------------------
# Telegraph node. The default is the live devnode used throughout the README.
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com

# --- Wallet (burner only) -----------------------------------------------------
# A throwaway testnet wallet that pays for answers. NEVER put a wallet with real
# funds here: the agent signs payments with it. Generate one with `npm run setup`
# or any wallet tool, and put the 0x-prefixed 32-byte hex key below.
TELEGRAPH_EVM_PRIVATE_KEY=0x...

# --- Ledger -------------------------------------------------------------------
# Where receipts are appended, one JSON line per attempt. Default:
# ~/.telegraph-purse/ledger.jsonl. Point it elsewhere to keep separate ledgers
# (for example one per demo run).
# PURSE_LEDGER=/home/you/.telegraph-purse/ledger.jsonl

# --- Caps ---------------------------------------------------------------------
# Checked after the node's price challenge and before anything is signed.
PURSE_MAX_PER_CALL_USD=0.05
PURSE_DAILY_CAP_USD=0.50

# Give up on an answer after this many milliseconds.
PURSE_TIMEOUT_MS=60000

# --- Intent allow-list --------------------------------------------------------
# A comma list restricts the purse to exactly those intents. An explicitly EMPTY
# value means no restriction: every intent the node routes to is permitted. Keep
# the restricted default unless you deliberately want the purse to be able to buy
# anything.
PURSE_ALLOWED_INTENTS=CRYPTO_PRICE_USD,WEATHER_CHECK_TEMPERATURE,WEB_SEARCH_GENERAL

# --- Miner pins ---------------------------------------------------------------
# intent=minerId pairs. A pinned intent is sent to that one miner through
# /engine/v1/ask/{miner} and is still paid through Telegraph. Weather is pinned
# by default because the auto-router kept choosing a weather miner whose tunnel
# was down on 2026-11-01, and the node settled those failed calls anyway.
# Set PURSE_PIN_MINERS= (empty) to auto-route everything.
PURSE_PIN_MINERS=WEATHER_CHECK_TEMPERATURE=20260821

# --- Settlement chain (advanced) ----------------------------------------------
# The live devnode charges in Telegraph test USDC on Ethereum Sepolia. These
# defaults match the network as verified on 2026-11-01 and re-verified 2026-11-09.
# EVM_NETWORK=eip155:11155111
# SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# USDC_ADDRESS=0xcc194e1a843B658526D0D5C431f670028582Ae17
